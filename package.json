{
  "name": "job-hunt",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "本地求职 skill、Node.js 服务与普通浏览器插件",
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "privacy": "node scripts/privacy-check.mjs",
    "check": "npm run privacy && npm run docs:check && npm test",
    "release:check": "node scripts/release-check.mjs",
    "docs:sync": "node scripts/configure-github.mjs",
    "github:configure": "node scripts/configure-github.mjs",
    "docs:check": "node scripts/configure-github.mjs --check"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "release.json",
    "scripts/",
    "server/",
    "extension/",
    "web/",
    "references/",
    "examples/"
  ]
}
